# vulnbank runtime configuration
PORT=4000

# The app itself connects with these (see src/db.ts)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vulnbank
DB_USER=vulnbank
# VULN-028 seeds a hardcoded fallback in src/db.ts; set this to override locally.

# Used by POST /api/admin/exec, which shells out to psql (VULN-023)
DATABASE_URL=postgresql://vulnbank:Sup3rS3cretBankPwd!@localhost:5432/vulnbank

UPLOAD_DIR=./uploads
SEED_ON_BOOT=true
