# Redfall Phase 1 configuration

# --- core services -----------------------------------------------------------
# The psycopg v3 driver is pinned in the URL: plain `postgresql://` resolves to
# psycopg2 under SQLAlchemy, which this project does not install.
DATABASE_URL=postgresql+psycopg://redfall:redfall@localhost:5432/redfall
REDIS_URL=redis://localhost:6379/0

# Scratch directory for sandbox workspaces. Defaults to the platform temp root
# plus /redfall when unset.
# REDFALL_WORKDIR=/tmp/redfall

# --- reasoning backend -------------------------------------------------------
# From 0.2.0 a provider key is one option among several. RedFall reasons through
# whichever backend the config selects: a key, an installed agent (Claude Code,
# Codex, Gemini CLI and nine more), an OpenAI-compatible endpoint, or a router
# over several. With nothing set, `auto` uses a key if present, otherwise the
# first detected agent, and refuses naming both when neither exists.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Force a backend without a redfall.toml. See redfall.toml.example for the file.
# REDFALL_BACKEND=agent          # auto | litellm | agent | openai_compat | custom | router
# REDFALL_AGENT=claude-code      # when REDFALL_BACKEND=agent
# REDFALL_BASE_URL=http://localhost:11434/v1   # when REDFALL_BACKEND=openai_compat
# REDFALL_MODEL=qwen2.5-coder:32b
# REDFALL_CONFIG=/path/to/redfall.toml         # explicit config file
# REDFALL_AGENT_MODEL_DEEP=claude-sonnet-4-5   # model hint per tier for an agent

# --- sandbox -----------------------------------------------------------------
# Must be a gVisor runtime. Redfall refuses to start a scan when the configured
# runtime is not registered with the Docker daemon.
REDFALL_SANDBOX_RUNTIME=runsc
REDFALL_SANDBOX_POOL_SIZE=3
REDFALL_SANDBOX_TIMEOUT_S=120

# --- budgets and limits ------------------------------------------------------
REDFALL_MAX_TOKENS_PER_SCAN=500000
REDFALL_MAX_COST_PER_SCAN_USD=10
REDFALL_BRANCH_MAX_DEPTH=3
# Chains the planner may propose for a scan. The gate's chain thresholds live in
# the range manifest, not here.
REDFALL_MAX_CHAINS=4

# --- range target (vulnbank) -------------------------------------------------
# The known-good patches move credentials out of source, so a patched vulnbank
# requires these. They are range values, not real secrets.
VULNBANK_PORT=4000
JWT_SECRET=range-only-jwt-secret-value
DB_PASSWORD=Sup3rS3cretBankPwd!
STRIPE_WEBHOOK_SECRET=whsec_range_only_value

# --- dashboard (web/) --------------------------------------------------------
# Where the dashboard looks for artifacts, and their file names inside that
# directory. Defaults: the repo root, `scan.json`, `range/report.json`.
# REDFALL_REPORT_DIR=/path/to/artifacts
# REDFALL_SCAN_REPORT=scan.json
# REDFALL_GATE_REPORT=report.json
