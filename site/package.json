{
  "name": "redfall-site",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "RedFall landing page and static documentation: prerendered React + Tailwind, deployed to GitHub Pages.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-server && node scripts/prerender.mjs && node scripts/build_docs.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "check:layout": "node scripts/mobile_check.mjs",
    "check:a11y": "node scripts/a11y_check.mjs",
    "check:seo": "node scripts/seo_check.mjs",
    "check:lighthouse": "node scripts/lighthouse_check.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "check:docs": "node scripts/docs_check.mjs",
    "check:monitor": "node scripts/seo_monitor.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.5.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "node-html-parser": "^9.0.5",
    "puppeteer-core": "^25.14.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
